{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chirper",
  "version": "0.1.2",
  "identifier": "app.chirper",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: chirper-media: http://chirper-media.localhost; media-src 'self' data: blob: chirper-media: http://chirper-media.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Chirper",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#0E1517",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "publisher": "Chirper contributors",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["chirper"]
      }
    }
  }
}
