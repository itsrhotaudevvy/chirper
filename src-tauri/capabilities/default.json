{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's own commands and the event listeners the UI uses. Plugins are called from Rust only, so no plugin permission is granted to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-start",
    "allow-networks",
    "allow-accounts",
    "allow-start-login",
    "allow-submit-login-input",
    "allow-submit-login-cookies",
    "allow-wait-login-step",
    "allow-cancel-login",
    "allow-logout",
    "allow-list-chats",
    "allow-get-chat",
    "allow-list-messages",
    "allow-load-older",
    "allow-sync-history",
    "allow-mark-unread",
    "allow-send-text",
    "allow-send-media",
    "allow-edit",
    "allow-redact",
    "allow-react",
    "allow-unreact",
    "allow-mark-read",
    "allow-set-typing",
    "allow-set-chat-flags",
    "allow-media-file",
    "allow-search",
    "allow-settings",
    "allow-set-settings",
    "allow-app-info",
    "allow-haptic",
    "allow-set-badge",
    "allow-notify-message",
    "allow-lock-status",
    "allow-unlock",
    "allow-set-secure-screen",
    "allow-open-external",
    "allow-set-app-prefs",
    "allow-get-app-prefs",
    "allow-pick-files"
  ]
}
